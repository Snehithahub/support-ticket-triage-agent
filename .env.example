# Copy to .env. Everything works offline with LLM_PROVIDER=fake (clearly labelled demo mode).

# --- LLM provider: fake | gemini | groq | openai | azure | custom ---
LLM_PROVIDER=fake
# Required for every provider except fake. Never commit a real key.
LLM_API_KEY=
# Optional overrides; presets fill these in for gemini/groq/openai.
# Gemini preset: https://generativelanguage.googleapis.com/v1beta/openai , gemini-2.5-flash
# Groq preset:   https://api.groq.com/openai/v1 , llama-3.3-70b-versatile
# Azure: LLM_BASE_URL=https://<resource>.openai.azure.com and LLM_MODEL=<deployment name>
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# Set false for models that reject response_format=json_object (the client also falls back automatically).
LLM_JSON_MODE=true

# --- Embeddings: fastembed (local, default) | api (provider /embeddings) | hash (offline tests) ---
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384

# --- Database (host port 15433 maps to the compose Postgres) ---
DATABASE_URL=postgresql://triagedesk:triagedesk@localhost:15433/triagedesk
POSTGRES_PASSWORD=triagedesk

# Base URL used for article links in drafts (the API serves /kb/{id}).
KB_BASE_URL=http://localhost:8401/kb

# --- n8n ---
# Any long random string; n8n uses it to encrypt stored credentials.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

LOG_LEVEL=INFO
LOG_JSON=true
